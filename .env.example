# Ambil API key GRATIS di https://aistudio.google.com/apikey (nggak perlu kartu kredit)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsional, default sudah gemini-2.5-flash (kualitas bagus, free tier: 10 request/menit, 250 request/hari)
# Kalau butuh kuota harian lebih besar, ganti ke gemini-2.5-flash-lite (15/menit, 1000/hari, kualitas sedikit di bawah)
AI_MODEL=gemini-2.5-flash

# Opsional, Railway akan set otomatis
PORT=3000
